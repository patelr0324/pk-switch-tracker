# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
TOKEN_ENCRYPTION_KEY=

# Optional — dev guild for DEV_MODE command registration and posting scope
DISCORD_GUILD_ID=

# Database (SQLite file; directory is created automatically)
DATABASE_PATH=./data/bot.db

# PluralKit API
PK_API_BASE=https://api.pluralkit.me/v2
PK_API_TIMEOUT_MS=45000
PK_API_MAX_RETRIES=4
POLL_INTERVAL_MS=30000

# Optional HTTP webhook listener (for external integrations)
WEBHOOK_PORT=8787
WEBHOOK_PATH=/pk-webhook
WEBHOOK_SECRET=

# Set true to register guild commands and limit switch posts to DISCORD_GUILD_ID
DEV_MODE=false
